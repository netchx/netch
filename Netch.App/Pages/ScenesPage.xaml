<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Netch.App.Pages.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Netch.App.Helpers"
    xmlns:vm="using:Netch.App.ViewModels">

    <Page.Resources>
        <Style x:Key="StatValueStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="StatLabelStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="StatButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <DataTemplate x:Key="SceneTemplate" x:DataType="vm:SceneCard">
            <ItemContainer AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" CornerRadius="8">
                <ItemContainer.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="Edit_Click" Tag="{x:Bind}" Text="{h:Tr Text=Edit}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE70F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="Duplicate_Click" Tag="{x:Bind}" Text="{h:Tr Text=Duplicate}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8C8;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="Edit_Click" Tag="{x:Bind}" Text="{h:Tr Text='Change node'}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8AB;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            Click="Pin_Click"
                            IsChecked="{x:Bind IsPinned, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Text="{h:Tr Text='Pin to tray'}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="Delete_Click" Tag="{x:Bind}" Text="{h:Tr Text=Delete}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ItemContainer.ContextFlyout>

                <Grid
                    MinHeight="120"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            Text="{x:Bind Icon, Mode=OneWay}" />
                    </Border>
                    <FontIcon
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE718;"
                        Visibility="{x:Bind IsPinned, Mode=OneWay}" />
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Summary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Status, Mode=OneWay}"
                            Visibility="{x:Bind IsNormal, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Status, Mode=OneWay}"
                            Visibility="{x:Bind IsActive, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Status, Mode=OneWay}"
                            Visibility="{x:Bind IsUnavailable, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Hotkey, Mode=OneWay}" />
                    </Grid>
                    <Border
                        Grid.RowSpan="4"
                        Margin="-12,-10"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <DataTemplate x:Key="AddTemplate" x:DataType="vm:AddSceneCard">
            <ItemContainer AutomationProperties.Name="{h:Tr Text='New scene'}" CornerRadius="8">
                <Grid
                    MinHeight="120"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE710;" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{h:Tr Text='New scene'}" />
                    </StackPanel>
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <h:SceneWallTemplateSelector
            x:Key="WallTemplates"
            AddTemplate="{StaticResource AddTemplate}"
            SceneTemplate="{StaticResource SceneTemplate}" />
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid RowSpacing="12" Visibility="{x:Bind HasScenes, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                Title="{h:Tr Text='Start failed'}"
                Closed="ErrorBar_Closed"
                IsOpen="{x:Bind HasText(Session.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind Session.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <Grid
                Grid.Row="1"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="16"
                CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Width="56"
                    Height="56"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind PowerLabel(Session.State), Mode=OneWay}"
                    Click="PowerButton_Click"
                    CornerRadius="28"
                    IsEnabled="{x:Bind CanUsePower(Session.State, HasScenes), Mode=OneWay}"
                    Style="{x:Bind PowerButtonStyle(Session.State), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind PowerLabel(Session.State), Mode=OneWay}">
                    <FontIcon FontSize="22" Glyph="&#xE7E8;" />
                </Button>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Fill="{ThemeResource SystemFillColorSuccessBrush}"
                            Visibility="{x:Bind Session.IsRunning, Mode=OneWay}" />
                        <TextBlock
                            FontSize="15"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Headline(Session.State, Session.ActiveScene), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Subline(Session.State, Session.ActiveScene, Session.Elapsed, Session.Progress), Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind Session.IsRunning, Mode=OneWay}">
                    <Polyline
                        x:Name="Sparkline"
                        Width="80"
                        Height="36"
                        VerticalAlignment="Center"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="2" />
                    <Button
                        Click="Latency_Click"
                        Style="{StaticResource StatButtonStyle}"
                        ToolTipService.ToolTip="{h:Tr Text='Test again'}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind LatencyText(Session.Latency, Session.LatencyTesting), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="{h:Tr Text=Latency}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="Nat_Click"
                        Style="{StaticResource StatButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind NatTip(Session.NatResult), Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind NatText(Session.NatResult, Session.NatTesting), Mode=OneWay}" />
                            <TextBlock Style="{StaticResource StatLabelStyle}" Text="NAT" />
                        </StackPanel>
                    </Button>
                    <StackPanel Padding="6,2" Visibility="{x:Bind Session.TrafficAvailable, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind h:Format.Rate(Session.BytesPerSecond), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource StatLabelStyle}" Text="{x:Bind TotalText(Session.TotalBytes), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{h:Tr Text=Scenes}" />
                <Button
                    HorizontalAlignment="Right"
                    Click="NewScene_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="{h:Tr Text='New scene'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsView
                Grid.Row="3"
                Margin="0,0,0,16"
                IsItemInvokedEnabled="True"
                ItemInvoked="SceneWall_ItemInvoked"
                ItemTemplate="{StaticResource WallTemplates}"
                ItemsSource="{x:Bind Cards}"
                SelectionMode="None">
                <ItemsView.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="3"
                        MinColumnSpacing="8"
                        MinItemHeight="120"
                        MinItemWidth="200"
                        MinRowSpacing="8" />
                </ItemsView.Layout>
            </ItemsView>
        </Grid>

        <StackPanel
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind IsEmpty, Mode=OneWay}">
            <Border
                Width="60"
                Height="60"
                HorizontalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="15">
                <FontIcon
                    FontSize="28"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xF0E2;" />
            </Border>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="15"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{h:Tr Text='No scenes yet'}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{h:Tr Text='A scene is a node plus a mode. Once created, one click connects it. No nodes yet? Import a subscription on the Nodes page first.'}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <StackPanel
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="NewScene_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="{h:Tr Text='New scene'}" />
                    </StackPanel>
                </Button>
                <Button Click="ImportSubscription_Click" Content="{h:Tr Text='Import subscription'}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>

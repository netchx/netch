<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StartupObject>RedirectorTester.RedirectorTester</StartupObject>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RedirectorOutputPath>..\Redirector\bin\$(Configuration)</RedirectorOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RedirectorOutputPath)\nfapi.dll;$(RedirectorOutputPath)\Redirector.bin;$(RedirectorOutputPath)\Redirector.pdb"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
